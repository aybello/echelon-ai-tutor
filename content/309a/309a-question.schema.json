{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echelon Institute Ontario 309A Question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questionNum",
    "bankKey",
    "module",
    "taskCode",
    "topic",
    "difficulty",
    "cognitiveLevel",
    "question",
    "options",
    "correctIndex",
    "explanation",
    "isCalc",
    "sourceTitle",
    "sourceUrl",
    "sourceReference",
    "blueprintObjective",
    "reviewStatus"
  ],
  "properties": {
    "questionNum": { "type": "integer", "minimum": 1, "maximum": 500 },
    "bankKey": { "const": "electrician-309a" },
    "module": { "enum": ["A", "B", "C", "D", "E"] },
    "taskCode": { "pattern": "^[A-E]-(?:[1-9]|1[0-9]|2[0-8])$" },
    "topic": { "type": "string", "minLength": 3, "maxLength": 128 },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "cognitiveLevel": { "enum": ["recall", "application"] },
    "question": { "type": "string", "minLength": 30 },
    "options": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "correctIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
    "explanation": { "type": "string", "minLength": 60 },
    "steps": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["l", "c"],
        "properties": { "l": { "type": "string" }, "c": { "type": "string" } }
      }
    },
    "tip": { "type": ["string", "null"] },
    "isCalc": { "enum": ["yes", "no"] },
    "diagramId": { "type": ["string", "null"] },
    "sourceTitle": { "type": "string", "minLength": 3 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "sourceReference": { "type": "string", "minLength": 3 },
    "blueprintObjective": { "type": "string", "minLength": 3 },
    "reviewStatus": { "enum": ["in_review", "approved"] },
    "reviewerNote": { "type": ["string", "null"] }
  }
}
